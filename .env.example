# ── SmartSort frontend env ─────────────────────────────────────────────
# Copy to .env.local and fill in. Values are per-worktree — never commit .env.local.

# MODE SWITCH: leave empty → built-in mock API (offline demo mode).
# Set to the deployed API base URL → the app calls the real backend
# (e.g. https://abc123.execute-api.ap-south-1.amazonaws.com — no trailing slash).
VITE_API_BASE_URL=

# Amazon Location (MapLibre) — both set → live map on the results screen.
# Style = Amazon Location map style URL, e.g.
#   https://maps.geo.ap-south-1.amazonaws.com/maps/v0/maps/Standard/style-descriptor
# Key   = Amazon Location API key (created in the Location console).
# Leave either empty → dev-safe SVG schematic (list-first behavior unchanged).
VITE_MAP_STYLE=
VITE_MAP_API_KEY=

# Demo location shown when geolocation is denied/unavailable (Bengaluru)
VITE_DEMO_LAT=12.9716
VITE_DEMO_LNG=77.5946
