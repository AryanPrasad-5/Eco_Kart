[TEMPLATE]
# ── SmartSort frontend env ─────────────────────────────────────────────
# Copy to .env.local and fill in. Values are per-worktree — never commit .env.local.

# MODE SWITCH: leave empty → built-in mock API (offline demo mode).
# Set to the deployed API base URL → the app calls the real backend
# (e.g. https://abc123.execute-api.ap-south-1.amazonaws.com — no trailing slash).
VITE_API_BASE_URL=

# Amazon Location (MapLibre) — both set → live interactive map (listing page).
# Map   = Amazon Location map NAME or full style URL (Console: Location Service →
#         Maps → e.g. "Standard" in ap-south-1). A bare name expands to
#         https://maps.geo.<REGION>.amazonaws.com/maps/v0/maps/<NAME>/style-descriptor
# Key   = Amazon Location API key (Location console → API keys, or CLI below).
#         Browser-scoped, referer-restricted, rotatable — never commit the real key.
# Leave either empty → dev-safe schematic locator (zero map tiles billed).
# CLI to create a key (after authenticating with an account that owns the map resource):
#   aws location create-key --key-name wastex-map-key --restriction-conditions \
#     'AllowActions=[geo-maps:GetTile,geo-maps:GetStyleDescriptor],AllowReferers=[http://localhost:5173/*,https://yourdomain/*]' \
#     --region ap-south-1
VITE_MAP_STYLE=Standard
VITE_MAP_API_KEY=

# Demo location shown when geolocation is denied/unavailable (Bengaluru)
VITE_DEMO_LAT=12.9716
VITE_DEMO_LNG=77.5946
